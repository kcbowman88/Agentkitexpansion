                    except Exception:
                        pass

                    await self.session.say(resp_final)
                    logging.info(f"Agent said objection response: '{resp_final}'")

                    # Opener-specific: immediately route, but DO NOT speak next-node script in same turn.
                    if state.current_node_id == "N_Opener_StackingIncomeHook_V3_CreativeTactic":
                        # Compute content-based transition key and perform transition now
                        trans_key = self._get_content_based_transition(state.current_node_id, user_input)
                        current_node_def = nodes.get(state.current_node_id) or {}
                        trans_map = current_node_def.get("transitions", {}) or {}
                        # Strict routing priority for opener objections
                        priority = []
                        if trans_key:
                            priority.append(trans_key)
                        # Ensure correct mapping for time pressure and callback requests over default/model intro
                        priority.extend(["not_interested", "no_time", "objection_or_callback_request", "no_recall", "question", "permission_granted", "default"])
                        for key in priority:
                            if key in trans_map:
                                # Suppress speaking the next-node script; only transition state
                                state.conversation_context["suppress_next_say"] = True
                                await self._transition_to_node(trans_map[key])
                                # Do not speak anything else this turn so last_agent_text remains the objection response
                                return
                        # If no transitions found, continue to normal processing
                    else:
                        # Legacy behavior for non-opener nodes
                        state.waiting_for_objection_response = True
                        return  # End the current turn here and wait for user input

                except Exception as e:
                    logging.error(f"Error handling objection: {e}", exc_info=True)
                    # Continue with normal processing
                    pass
                    
            # 3. Handle PSP follow-up if needed
            if 'pending_psp_followup' in state.conversation_context:
                try:
                    follow_up_response = self.objection_handler.get_follow_up_response(
