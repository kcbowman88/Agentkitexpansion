            # Log the error but don't try to recover by restarting the conversation
            # The session will naturally end if the error is unrecoverable

    def _get_content_based_transition(self, node_id: str, user_input: str) -> Optional[str]:
        """
        Determine transition based on content analysis of user input for specific nodes.

        Args:
            node_id (str): The current node ID
            user_input (str): The user's response

        Returns:
            Optional[str]: The transition key if a content-based transition is determined, None otherwise
        """
        logging.debug(f"_get_content_based_transition called node_id='{node_id}' user_input='{user_input}'")
        try:
            user_input_lower = user_input.lower().strip()
            current_node = nodes.get(node_id)

            if not current_node:
                return None

            transitions = current_node.get("transitions", {})

            # Fast-route consent-like signals for opener to IntroduceModel
            if node_id == "N_Opener_StackingIncomeHook_V3_CreativeTactic":
                text = user_input_lower

                # Explicit empty or clipped affirmatives act as consent
                clipped_set = {"", "yeah", "ya", "yep", "ok", "okay", "mm-hmm", "mmhmm", "uh huh", "uh-huh", "sure", "alright"}
                if text in clipped_set:
                    logging.info("opener_fast_route_detected=clipped_affirmative -> permission_granted")
                    if "permission_granted" in transitions:
                        return "permission_granted"
                    return "default" if "default" in transitions else None

                # Curiosity pokes treated as consent (route to IntroduceModel, not KB)
                curiosity_phrases = [
                    "like what", "what kind of", "how does that even work", "how does it even work",
                    "how would that work", "how’s that work", "hows that work"
                ]
                if any(p in text for p in curiosity_phrases):
                    logging.info("opener_fast_route_detected=curiosity_poke -> permission_granted")
                    if "permission_granted" in transitions:
                        return "permission_granted"
                    return "default" if "default" in transitions else None

                # Soft trust / legitimacy probes treated as consent (next node handles credibility/context)
                soft_trust_phrases = [
                    "is this legit", "is this legitimate", "whats the catch", "what's the catch",
                    "sounds like a pitch", "this sounds like a pitch", "is this a scam", "is this for real"
                ]
                if any(p in text for p in soft_trust_phrases):
                    logging.info("opener_fast_route_detected=soft_trust_probe -> permission_granted")
                    if "permission_granted" in transitions:
                        return "permission_granted"
                    return "default" if "default" in transitions else None

            # Special handling for N200 node (Work and Income Background)
            if node_id == "N200_Super_WorkAndIncomeBackground_V3_Adaptive":
                # PRIORITY 1: Business owner responses
                # Must filter out past/future tenses (e.g., 'I used to own...', 'I plan to start...')
                business_owner_indicators = [
                    "run my own business", "own my own business", "i'm an entrepreneur",
                    "i have my own business", "i'm self-employed", "i'm a business owner",
                    "i operate my own business", "i manage my own business"
                ]
                
                # Check for business owner indicators that aren't in past/future context
                is_business_owner = any(indicator in user_input_lower for indicator in business_owner_indicators) and \
                                   not any(past_indicator in user_input_lower for past_indicator in ["used to", "was", "were", "had", "will", "going to", "plan to"])
                
                if is_business_owner and "business_owner" in transitions:
