    def _generate_dynamic_kb_qa_script(self, state: CallFlowState) -> str:
        """
        Generate a dynamic script for the N_KB_Q&A_With_StrategicNarrative_V3_Adaptive node
        based on user data, conversation context, and knowledge base queries.
        
        Args:
            state (CallFlowState): The current conversation state
            
        Returns:
            str: The dynamically generated script
        """
        try:
            # Get user data for personalization
            customer_name = state.customer_name or "there"
            personality_type = state.personality_type or "S"
            engagement_level = state.qualification_status.get('engagement_level', 5)
            expressed_interests = state.user_preferences.get('interests', [])
            
            # Check if income data is available (collected in N200 and subsequent nodes)
            employment_status = state.user_preferences.get('employment_status')
            income_level = state.user_preferences.get('income_level')
            has_income_data = employment_status is not None and income_level is not None
            
            # Query KB based on user interests and conversation history
            kb_response = self._query_knowledge_base(expressed_interests, state.conversation_history)
            
            # Generate income potential statement
            if has_income_data:
                # Generate dynamic income figures based on user's financial situation
                dynamic_income_range = self._calculate_dynamic_income_range(income_level, employment_status, engagement_level)
                # Generate income potential statement with dynamic figures
                income_statement = self._generate_income_statement(dynamic_income_range, employment_status, income_level)
            else:
                # Use generic income statement when income data is not available yet
                income_statement = "Many of our students have been able to generate significant income - we've seen people make anywhere from an extra $20,000 to over a million dollars per month."
            
            # Generate adaptive closing question based on user's previous responses
            closing_question = self._generate_adaptive_question(state)
            
            # Clean the KB response to remove introductory phrases
            cleaned_kb_response = self._clean_kb_response(kb_response)
            
            # Combine all parts into the final script with smoother transitions
            # The cleaned KB response provides the core information.
            # The income statement adds value.
            # The closing question drives engagement.
            script = f"{cleaned_kb_response} {income_statement}"
            
            # Apply enforce_pivot to ensure goal-oriented question is appended
            # Create a dummy context for enforce_pivot, as it expects an ObjectionContext
            # This is a workaround since _generate_dynamic_kb_qa_script doesn't have direct access to thread_id/node_id/persona
            # A more robust solution would be to pass these parameters down or refactor
            dummy_ctx = ObjectionContext(thread_id=state.thread_id or "default_thread", 
                                         node_id=state.current_node_id, 
                                         persona=state.personality_type or "S")
            script = self.objection_handler.enforce_pivot(script, dummy_ctx)
            
            return script
        except Exception as e:
            logging.error(f"Error in _generate_dynamic_kb_qa_script: {e}", exc_info=True)
            # Fallback to static script
            return "It's pretty simple, we rank websites for you around some local business, think tree services or plumbing, and then we sell the leads generated from that site to local businesses and bank the passive income. Would you be upset even with just an extra $20k a month?"
            
    def _clean_kb_response(self, response: str) -> str:
        """
        Cleans the KB response by removing common introductory phrases that sound like an AI.
        """
        phrases_to_remove = [
            "Based on the information provided in the conversation context, ",
            "Based on the information provided, ",
            "In general, ",
            "The business opportunity mentioned seems to involve ",
            "The business model appears to focus on ",
            "If you are interested in pursuing this business opportunity, it is essential to conduct thorough due diligence, manage expectations regarding SEO complexities, and consider the potential for dependency within the ecosystem. Additionally, addressing reputational risks and staying informed about industry trends and competition could be crucial for success. "
        ]
        
        cleaned_response = response
        for phrase in phrases_to_remove:
            cleaned_response = cleaned_response.replace(phrase, "")
            
        # Remove any leading whitespace that might result from removal
        cleaned_response = cleaned_response.strip()
        
        # Ensure the first letter is capitalized if it's a sentence start
        if cleaned_response and cleaned_response[0].islower():
            cleaned_response = cleaned_response[0].upper() + cleaned_response[1:]
            if next_node_id == "N_KB_Q&amp;A_With_StrategicNarrative_V3_Adaptive":
                logging.info("Transitioning to KB Q&amp;A node - this is where the issue might occur")
                logging.info("Checking if KB functionality is properly implemented...")

                # Force KB-once path: bypass gating and speak KB content immediately (used by inline company intent)
                if bool(state.conversation_context.pop("force_kb_once", False)):
                    logging.info("kb_forced_transition=true; bypassing KB gating and speaking now")
                    dynamic_script = self._generate_dynamic_kb_qa_script(state)
                    script = finalize_agent_text(state, dynamic_script, is_objection=False)
                    await self.session.say(script)
                    logging.info(f"POST-SAY (KB-forced): len={len(script)} repr={repr(script)}")
                    self.session.clear_user_turn()
                    return

                # If this transition immediately follows an opener objection, do not generate/say KB script now
                if bool(state.conversation_context.get("suppress_kb_script_once")):
                    logging.info("KB script generation will be suppressed this turn due to opener objection routing.")
            
        return cleaned_response

    def _calculate_dynamic_income_range(self, income_level: float, employment_status: str, engagement_level: int) -> dict:
        """
        Calculate dynamic income range based on user's financial situation
        
        Args:
            income_level (float): User's current income level
            employment_status (str): User's employment status
            engagement_level (int): User's engagement level (0-10)
            
        Returns:
            dict: Dictionary with lower and upper bounds of income range
        """
        try:
            # Adjust range based on employment status
            if employment_status == "unemployed":
                # For unemployed users, reference past income
                lower_bound = income_level * 0.3  # 30% of past income
                upper_bound = income_level * 1.5  # 150% of past income
            elif employment_status == "business_owner":
                # For business owners, reference revenue
                lower_bound = income_level * 0.2  # 20% of current revenue
                upper_bound = income_level * 2.0  # 200% of current revenue
            else:
                # For employed users, reference current income
                lower_bound = income_level * 0.4  # 40% of current income
                upper_bound = income_level * 1.2  # 120% of current income
                
            # Adjust range based on engagement level
            engagement_multiplier = 0.8 + (engagement_level / 10) * 0.4  # Range from 0.8 to 1.2
            lower_bound *= engagement_multiplier
            upper_bound *= engagement_multiplier
            
            return {
               "lower": round(lower_bound, -3),  # Round to nearest thousand
               "upper": round(upper_bound, -3)   # Round to nearest thousand
           }
        except Exception as e:
            logging.error(f"Error in _calculate_dynamic_income_range: {e}", exc_info=True)
            # Return default range
            return {"lower": 20000, "upper": 1000000}
            
    def _get_personality_based_opening(self, customer_name: str, personality_type: str, expressed_interests: list) -> str:
        """
        Generate a personalized opening based on personality type
        
        Args:
            customer_name (str): The customer's name
            personality_type (str): The user's DISC personality type
            expressed_interests (list): List of user's expressed interests
            
        Returns:
            str: Personalized opening statement
        """
        try:
            # Create interest-based phrase
            interest_phrase = ""
            if expressed_interests:
                # Take the first interest mentioned
                interest = expressed_interests[0] if expressed_interests else ""
                interest_phrase = f"especially when you mentioned {interest}, "
            
            # Generate opening based on personality type
            if personality_type == "D":  # Dominant
                return f"Alright {customer_name}, let's get straight to it. {interest_phrase}People like you have seen great results with this model."
            elif personality_type == "I":  # Influential
                return f"That's a fantastic question, {customer_name}! {interest_phrase}I'm excited to share how people in your situation are seeing amazing results."
            elif personality_type == "C":  # Conscientious
                return f"I appreciate your thoroughness, {customer_name}. {interest_phrase}Our data shows consistent results for people with similar profiles using our systematic approach."
            else:  # Steady (default)
                return f"I hear your questions, {customer_name}, and I'm happy to help. {interest_phrase}This opportunity could be a really good fit for you."
        except Exception as e:
            logging.error(f"Error in _get_personality_based_opening: {e}", exc_info=True)
            return f"I hear your questions, {customer_name}, and I'm happy to help."
            
    def _generate_income_statement(self, income_range: dict, employment_status: str, income_level: float) -> str:
        """
        Generate an income statement with dynamic figures
        
        Args:
            income_range (dict): Dictionary with lower and upper bounds
            employment_status (str): User's employment status
            income_level (float): User's income level
            
        Returns:
            str: Income statement with dynamic figures
        """
        try:
            lower = income_range["lower"]
            upper = income_range["upper"]
            
            # Format numbers for readability
            if lower >= 1000000:
                lower_str = f"${lower/1000000:.1f} million"
            elif lower >= 1000:
                lower_str = f"${lower/1000:.0f}k"
            else:
                lower_str = f"${lower}"
                
            if upper >= 1000000:
                upper_str = f"${upper/1000000:.1f} million"
            elif upper >= 1000:
                upper_str = f"${upper/1000:.0f}k"
            else:
                upper_str = f"${upper}"
            
            # Adjust statement based on employment status
            if employment_status == "unemployed":
                return f"Based on your previous income of ${income_level:,.0f}, many people in similar situations have been able to rebuild and exceed that amount, with some generating {lower_str} to {upper_str} per month."
            elif employment_status == "business_owner":
                return f"With your business already generating ${income_level:,.0f} per month, our students have found they can create an additional {lower_str} to {upper_str} through this model."
            else:  # employed
                return f"Building on your current income of ${income_level:,.0f}, many of our students have been able to generate an additional {lower_str} to {upper_str} per month."
        except Exception as e:
            logging.error(f"Error in _generate_income_statement: {e}", exc_info=True)
            return "Many of our students have been able to generate significant income - we've seen people make anywhere from an extra $20,000 to over a million dollars per month."
            
    def _generate_adaptive_question(self, state: CallFlowState) -> str:
        """
        Generate an adaptive closing question based on user's previous responses
        
        Args:
            state (CallFlowState): The current conversation state
            
        Returns:
            str: Adaptive closing question
        """
        try:
            # Get user data
            previous_questions = state.user_preferences.get('previous_questions', [])
            expressed_interests = state.user_preferences.get('interests', [])
            employment_status = state.user_preferences.get('employment_status', 'employed')
            personality_type = state.personality_type or "S"
            engagement_level = state.qualification_status.get('engagement_level', 5)
            
            # Check if user asked technical questions
            technical_keywords = ['how', 'technical', 'process', 'system', 'method']
            has_technical_questions = any(
                any(keyword in q.lower() for keyword in technical_keywords)
                for q in previous_questions
            )
            
            # Check if user asked about timeline
            timeline_keywords = ['when', 'timeline', 'quick', 'fast', 'soon']
            has_timeline_questions = any(
                any(keyword in q.lower() for keyword in timeline_keywords)
                for q in previous_questions
            )
            
            # Check if user asked about risk
            risk_keywords = ['risk', 'safe', 'secure', 'guarantee', 'concern']
            has_risk_questions = any(
                any(keyword in q.lower() for keyword in risk_keywords)
                for q in previous_questions
            )
            
            # Check if user asked about time commitment
            time_commitment_keywords = ['time', 'hours', 'commitment', 'busy']
            has_time_commitment_questions = any(
                any(keyword in q.lower() for keyword in time_commitment_keywords)
                for q in previous_questions
            )
            
            # Generate question based on what the user asked about
            if has_technical_questions and expressed_interests:
                interest = expressed_interests[0] if expressed_interests else "this"
                return f"Since you've asked about the technical aspects of {interest}, would you like me to dive deeper into how that works, or are you more curious about the financial potential we've seen with people in similar situations?"
            elif has_timeline_questions:
                timeframe = "a few months" if engagement_level > 5 else "6-12 months"
                return f"You mentioned wanting to see results quickly. Based on what I know about your situation, many of our students start seeing significant results within {timeframe}. Would you like to know what makes that possible for people like you?"
            elif has_risk_questions:
                experience = "your background"  # This would be more specific in a real implementation
                return f"I understand your concern about risk. Given {experience}, many people with similar profiles have been able to generate substantial income with our lowest-risk approach. What specific aspects of risk management would you like to know more about?"
            elif has_time_commitment_questions:
                time_commitment = "just a few hours per week" if engagement_level > 5 else "5-10 hours per week"
                return f"You asked about time commitment, which is important for someone in your situation. People with similar profiles have been able to generate substantial income while spending {time_commitment}. Would you like to know how they make that work?"
            else:
                # Default adaptive question
                if engagement_level > 7:
                    # High engagement
                    interest_phrase = ""
                    if expressed_interests:
                        interest = expressed_interests[0] if expressed_interests else ""
                        interest_phrase = f"especially since you're interested in {interest}, "
                    return f"I can see you're really engaged with this concept, {interest_phrase}what specific aspects would you like to know more about?"
                elif engagement_level > 3:
                    # Medium engagement
                    return "I appreciate your questions. What aspects of this opportunity are you most curious about?"
                else:
                    # Low engagement
                    return "What's the most important thing for you to understand about this opportunity?"
        except Exception as e:
            logging.error(f"Error in _generate_adaptive_question: {e}", exc_info=True)
            return "Now, I'm curious - what aspects of this opportunity are you most interested in learning more about?"
            
    def _query_knowledge_base(self, interests: list, conversation_history: list) -> str:
        """
        Query the knowledge base for information related to user interests and conversation history.
        
        Args:
            interests: List of user's expressed interests
            conversation_history: History of the conversation
            
        Returns:
            str: Response from the knowledge base
        """
        try:
            # Create a query from user interests and recent conversation
            recent_context = self._get_recent_context(conversation_history)
            
            if interests:
                query = f"Based on the conversation, the user is interested in {', '.join(interests)}. {recent_context}"
            else:
                query = f"What are the key benefits of our business model? {recent_context}"
            
            # Query the KB processor
            kb_response = self.kb_processor.query(query)
            
            return kb_response
        except Exception as e:
            logging.error(f"Error querying knowledge base: {e}", exc_info=True)
            return "Based on what I've learned, our program has many benefits that can help you achieve your goals."
 
    def _get_recent_context(self, conversation_history: list) -> str:
        """
        Extract recent context from conversation history.
        
        Args:
            conversation_history: History of the conversation
            
        Returns:
            str: Recent conversation context
        """
        try:
            if not conversation_history:
                return ""
            
            # Get the last 3 exchanges (user and agent)
            recent_exchanges = conversation_history[-6:]  # Last 3 exchanges (2 messages each)
            
            context = "Recent conversation context: "
            for exchange in recent_exchanges:
                speaker = exchange.get('speaker', 'unknown')
                text = exchange.get('text', '')
                context += f"{speaker}: {text} "
                
            return context
        except Exception as e:
            logging.error(f"Error getting recent context: {e}", exc_info=True)
            return ""
 
    async def _transition_to_node(self, next_node_id: str):
        """
        Transition to the next node in the conversation flow.
        
        Args:
            next_node_id (str): The ID of the next node to transition to
        """
        try:
            state: CallFlowState = self.session.userdata
            
            # Log the transition attempt
            logging.info(f"Attempting to transition to node: {next_node_id}")
            
            # Special logging for KB Q&A node
            if next_node_id == "N_KB_Q&A_With_StrategicNarrative_V3_Adaptive":
                logging.info("Transitioning to KB Q&A node - this is where the issue might occur")
                logging.info("Checking if KB functionality is properly implemented...")
                # If this transition immediately follows an opener objection, do not generate/say KB script now
                if bool(state.conversation_context.get("suppress_kb_script_once")):
                    logging.info("KB script generation will be suppressed this turn due to opener objection routing.")
            
            # Validate the next node ID
            if not next_node_id or not isinstance(next_node_id, str):
                logging.error(f"Invalid next node ID: {next_node_id}")
                # Fallback to a safe node or end the conversation
                next_node_id = "N001A_NameConfirmation_Only"  # Fallback to initial node
            
            # Check if this transition is part of an A/B test
            try:
                ab_test_node_id = ab_test_manager.get_node_for_user("intro_test_001", state.customer_name or "default_user")
                if ab_test_node_id:
                    next_node_id = ab_test_node_id
                    logging.info(f"A/B test assigned node: {next_node_id}")
            except Exception as e:
                logging.error(f"Error checking A/B test: {e}", exc_info=True)
            
            # Update the state
            state.current_node_id = next_node_id
            
            # Get the next node
            next_node = nodes.get(next_node_id)
            if not next_node:
                logging.error(f"Node '{next_node_id}' not found in call_flow.")
                # Try to fallback to a safe node
                fallback_node_id = "N001A_NameConfirmation_Only"
<![CDATA[
                # Forced KB bypass: if set by inline company-intent path, skip gating and speak KB node script now
                if bool(state.conversation_context.pop("force_kb_once", False)):
                    logging.info("kb_forced_transition=True; bypassing KB gating and speaking KB node script")
                    script_forced = next_node.get("script", "")
                    if state.customer_name:
                        script_forced = script_forced.replace("{{customer_name}}", state.customer_name)
                    script_forced = finalize_agent_text(state, script_forced, is_objection=False)
                    await self.session.say(script_forced)
                    logging.info(f"POST-SAY (KB-forced): len={len(script_forced)} repr={repr(script_forced)}")
                    self.session.clear_user_turn()
                    return
]]>
                next_node = nodes.get(fallback_node_id)
                if not next_node:
                    logging.error(f"Fallback node '{fallback_node_id}' also not found.")
                    try:
                        await self.session.close()
                    except Exception as close_error:
                        logging.error(f"Error closing session: {close_error}", exc_info=True)
                    return
                else:
                    # Update state to fallback node
                    state.current_node_id = fallback_node_id
                    logging.info(f"Falling back to node: {fallback_node_id}")
            
            # Record analytics for agent turn
            script = next_node["script"]
            if state.customer_name:
                script = script.replace("{{customer_name}}", state.customer_name)
            
            conversation_analytics.record_turn('agent', script)
            
            # Log the script that will be spoken
            logging.info(f"About to speak script: '{script}'")
            logging.info(f"Script length: {len(script)} characters")
            
            # If an opener objection just occurred and suppression flag is set, do not speak the next-node script
            suppress_next = bool(state.conversation_context.pop("suppress_next_say", False))
            if suppress_next:
                logging.info("suppress_next_say=True; next script will not be spoken.")
            if suppress_next:
                logging.info("Suppressing next-node script speak due to objection-immediate route; state transitioned only.")
                self.session.clear_user_turn()
                return
            
            # Special handling for KB Q&A node to use dynamic script generation
            if next_node_id == "N_KB_Q&A_With_StrategicNarrative_V3_Adaptive":
                # If this KB transition immediately follows an opener objection route, suppress speaking this turn
                if bool(state.conversation_context.pop("suppress_kb_script_once", False)):
                    logging.info("KB script generation suppressed due to immediate opener objection route.")
                    self.session.clear_user_turn()
                    return
                # Gate KB invocation
                last_user = ""
                try:
                    # last user message from history if exists
                    for entry in reversed(state.conversation_history):
                        if entry.get("speaker") == "user":
                            last_user = entry.get("text", "")
                            break
                except Exception:
                    pass
                if not self._should_invoke_kb(state, last_user):
                    logging.info("KB gating blocked KB speak; rerouting to IntroduceModel default path.")
                    # Prefer IntroduceModel default if present in call_flow
                    fallback_intro = nodes.get("N_IntroduceModel_And_AskQuestions_V3_Adaptive")
                    if fallback_intro:
                        state.current_node_id = "N_IntroduceModel_And_AskQuestions_V3_Adaptive"
                        script = fallback_intro["script"]
                        if state.customer_name:
                            script = script.replace("{{customer_name}}", state.customer_name)
                        script = finalize_agent_text(state, script, is_objection=False)
                        await self.session.say(script)
                        logging.info(f"POST-SAY (KB-gated->Intro): len={len(script)} repr={repr(script)}")
                        self.session.clear_user_turn()
                        return
                    # If no intro node, silently suppress KB speak this turn
                    self.session.clear_user_turn()
                    return
                logging.info("About to speak KB Q&A script - using dynamic generation")
                dynamic_script = self._generate_dynamic_kb_qa_script(state)
                logging.info("Dynamic script for KB Q&A node:")
                logging.info(dynamic_script)
                script = finalize_agent_text(state, dynamic_script, is_objection=False)
                script = finalize_agent_text(state, script, is_objection=False)
                await self.session.say(script)
                logging.info(f"POST-SAY (KB): len={len(script)} repr={repr(script)}")
            else:
                # Speak the standard next node script (non-KB)
                script = finalize_agent_text(state, script, is_objection=False)
                await self.session.say(script)
                logging.info(f"POST-SAY: len={len(script)} repr={repr(script)}")
            
            # Clear the user turn to prepare for the next response
            self.session.clear_user_turn()
        except Exception as e:
            logging.error(f"Unexpected error in _transition_to_node: {e}", exc_info=True)
            # Log the error but don't try to recover by restarting the conversation
            # The session will naturally end if the error is unrecoverable
 
    def _contains_objection(self, user_input: str) -> bool:
        """
        Check if user input contains an objection
        
        Args:
            user_input (str): The user's response
            
        Returns:
            bool: True if the input contains an objection
        """
        try:
            # Check if input is a question (ends with ? or contains question words)
            user_input_lower = user_input.lower().strip()
            is_question = (
                user_input_lower.endswith('?') or
                any(word in user_input_lower for word in ['what', 'how', 'why', 'when', 'where', 'which', 'question'])
            )
            
            
            # Check for explicit objection indicators
            objection_indicators = [
                "no", "not interested", "busy", "don't have time", "not now",
                "too expensive", "too costly", "can't afford", "not for me",
                "don't need", "not relevant", "skeptical", "doubt", "concern",
                "risk", "guarantee", "proof", "evidence", "scam", "legitimate",
                "too much", "don't believe", "not possible", "can't make",
                "really", "not really" # Added to catch more subtle objections
            ]
            
            return any(indicator in user_input_lower for indicator in objection_indicators)
        except Exception as e:
            logging.error(f"Error in _contains_objection: {e}", exc_info=True)
            return False  # Assume no objection if there's an error
 
    def _is_ambiguous(self, user_input: str) -> bool:
        """
        Check if user input is ambiguous
        
        Args:
            user_input (str): The user's response
            
        Returns:
            bool: True if the input is ambiguous
        """
        try:
            ambiguous_indicators = [
                "huh", "what", "hmm", "uh", "um", "er", "well", "so", "okay",
                "i see", "right", "yeah", "yes", "no", "maybe", "perhaps"
            ]
            
            user_input_lower = user_input.lower().strip()
            return user_input_lower in ambiguous_indicators or len(user_input_lower) < 3
        except Exception as e:
            logging.error(f"Error in _is_ambiguous: {e}", exc_info=True)
            return True  # Assume ambiguous if there's an error
 
    def _contains_monetary_value(self, text: str) -> bool:
        """
        Check if text contains monetary values.
        
        Args:
            text (str): The text to analyze
            
        Returns:
            bool: True if the text contains monetary values
        """
        try:
            text_lower = text.lower()
            
            # Check for common monetary value patterns
            monetary_patterns = [
                r'\$\d+',  # $ followed by digits
                r'\d+\s*dollars',  # digits followed by "dollars"
                r'\d+\s*grand',  # digits followed by "grand"
                r'\d+\s*k',  # digits followed by "k"
                r'\d+\s*thousand',  # digits followed by "thousand"
                r'\d+\s*million',  # digits followed by "million"
                r'\d+\s*m',  # digits followed by "m"
                r'\d+\s*billion',  # digits followed by "billion"
                r'\d+\s*b',  # digits followed by "b"
                r'\d+\s*figures',  # digits followed by "figures"
                r'\d+[kKmM]'  # digits followed by k/K/m/M
            ]
            
            # Check for monetary indicators
            monetary_indicators = ["k a year", "k a month", "figures", "dollars", "thousand", "million", "billion", "$", "£", "€"]
            
            # Check if any pattern matches or any indicator is present
            import re
            for pattern in monetary_patterns:
                if re.search(pattern, text_lower):
                    return True
                    
            return any(indicator in text_lower for indicator in monetary_indicators)
        except Exception as e:
            logging.error(f"Error in _contains_monetary_value: {e}", exc_info=True)
            return False  # Assume no monetary value if there's an error
            
    def _track_user_preferences(self, state: CallFlowState, user_input: str):
        """
        Track user preferences, questions, and interests for personalization
        
        Args:
            state (CallFlowState): The current conversation state
            user_input (str): The user's input
        """
        try:
            # Initialize user preferences if not present
            if not state.user_preferences:
                state.user_preferences = {}
                
            # Initialize previous questions list if not present
            if 'previous_questions' not in state.user_preferences:
                state.user_preferences['previous_questions'] = []
                
            # Initialize interests list if not present
            if 'interests' not in state.user_preferences:
                state.user_preferences['interests'] = []
                
            # Check if user input is a question
            user_input_lower = user_input.lower().strip()
            is_question = (
                user_input_lower.endswith('?') or
                any(word in user_input_lower for word in ['what', 'how', 'why', 'when', 'where', 'which'])
            )
            
            # If it's a question, add to previous questions
            if is_question:
                state.user_preferences['previous_questions'].append(user_input)
                # Keep only the last 5 questions
                if len(state.user_preferences['previous_questions']) > 5:
                    state.user_preferences['previous_questions'] = state.user_preferences['previous_questions'][-5:]
            
            # Extract potential interests from user input
            # This is a simplified approach - in a real implementation, you might use NLP
            interest_keywords = [
                'income', 'money', 'passive', 'business', 'opportunity', 'website',
                'traffic', 'leads', 'rank', 'google', 'seo', 'digital', 'real estate',
                'time', 'flexibility', 'freedom', 'schedule', 'work', 'job'
            ]
            
            # Find interests in user input
            found_interests = []
            for keyword in interest_keywords:
                if keyword in user_input_lower and keyword not in state.user_preferences['interests']:
                    found_interests.append(keyword)
                    
            # Add new interests to the list
            state.user_preferences['interests'].extend(found_interests)
            # Keep only unique interests
            state.user_preferences['interests'] = list(set(state.user_preferences['interests']))
            # Keep only the last 10 interests
            if len(state.user_preferences['interests']) > 10:
                state.user_preferences['interests'] = state.user_preferences['interests'][-10:]
            
            # Extract employment status indicators
            employment_indicators = {
                'business_owner': ['own business', 'self-employed', 'entrepreneur', 'business owner'],
                'unemployed': ['unemployed', 'laid off', 'no job', 'between jobs'],
                'employed': ['employed', 'have a job', 'work for']
            }
            
            # Check for employment status in user input
            for status, indicators in employment_indicators.items():
                if any(indicator in user_input_lower for indicator in indicators):
                    state.user_preferences['employment_status'] = status
                    break
            
            # Extract income level if mentioned
            # This is a simplified approach - in a real implementation, you might use more sophisticated parsing
            import re
            monetary_matches = re.findall(r'\$(\d+(?:,\d+)?)', user_input)
            if monetary_matches:
                # Take the first monetary value mentioned
                try:
                    income_value = int(monetary_matches[0].replace(',', ''))
                    state.user_preferences['income_level'] = income_value
                except ValueError:
                    pass  # Ignore if we can't parse the value
                    
            logging.info(f"Updated user preferences: {state.user_preferences}")
        except Exception as e:
            logging.error(f"Error in _track_user_preferences: {e}", exc_info=True)
            # Continue without tracking preferences if there's an error
            
    async def _prepare_for_user_response(self, current_node: dict):
        """
        Dynamically builds the agent's tools and prompt for the current turn.
        """
        try:
            state: CallFlowState = self.session.userdata
            
            # Build the dynamic tool for transitioning state
            transition_tool = self._create_transition_tool(current_node)
            await self.update_tools([transition_tool])
            
            # Build the dynamic prompt for the LLM
            prompt = self._build_dynamic_prompt(current_node)
            await self.update_instructions(prompt)
            
            logging.info(f"Agent prepared for user response at node {state.current_node_id}.")
            logging.debug(f"Available transitions: {list(current_node.get('transitions', {}).keys())}")
        except Exception as e:
            logging.error(f"Error in _prepare_for_user_response: {e}", exc_info=True)
            # Log the error but don't try to recover by restarting the conversation
            # The session will naturally end if the error is unrecoverable

    def _build_dynamic_prompt(self, current_node: dict) -> str:
        """Constructs the full prompt for the LLM for the current turn."""
        try:
            state: CallFlowState = self.session.userdata
            
            # Get available transitions and describe them for the LLM
            transitions = current_node.get("transitions", {})
            transition_descriptions = "\n".join([f"- '{key}': to transition to node '{value}'." for key, value in transitions.items()])
            
            # Append the dynamic context to the global prompt
            dynamic_context = f"""## SECTION 6: YOUR CURRENT TASK
            
            *   **Your Current State:** You are at conversation node '{state.current_node_id}'.
            *   **Your Last Utterance:** You just said: "{current_node['script']}"
            *   **Your Immediate Goal:** Listen to the user's response and determine their intent. Based on their intent, you MUST call the `transition_to_next_node` tool to move to the appropriate next state.
            *   **Available Transitions:** You must choose one of the following transition keys based on the user's intent:
            {transition_descriptions}
            *   **Default Behavior:** If the user's intent is ambiguous or doesn't fit any other category, use the 'default' transition if available.
            *   **IMPORTANT RULE:** You MUST ONLY respond by calling the `transition_to_next_node` tool. Do not generate any other text response. The tool call is the only valid response."""
            return f"{GLOBAL_PROMPT}\n{dynamic_context}"
        except Exception as e:
            logging.error(f"Error in _build_dynamic_prompt: {e}", exc_info=True)
            # Return a minimal prompt as fallback
            state: CallFlowState = self.session.userdata
            return f"""{GLOBAL_PROMPT}
            
            ## SECTION 6: YOUR CURRENT TASK
            
            *   **Your Current State:** You are at conversation node '{state.current_node_id}'.
            *   **Error Recovery:** An error occurred while building the dynamic prompt.
            *   **Action:** Please transition to the next node using the available tool.
            
            Please use the `transition_to_next_node` tool to continue the conversation."""
 
    def _create_transition_tool(self, current_node: dict) -> llm.FunctionTool:
        """
        Factory method to create a dynamic function_tool for state transitions.
        The tool's schema is constrained to only allow valid next nodes.
        """
        try:
            state: CallFlowState = self.session.userdata
            
            # 1. Get the valid transitions for the current node
            transitions = current_node.get("transitions", {})
            if not transitions:
                # If no transitions, create a tool that does nothing to avoid errors
                async def no_op(context: RunContext):
                    logging.warning(f"No transitions available from node {state.current_node_id}")
                    return "No transitions available."
                return function_tool(no_op, name="transition_to_next_node", description="No transitions defined for this state.")
            
            # 2. Create a dynamic Enum for the allowed transition keys
            # The name must be unique for each schema generation
            enum_name = f"ValidTransitions_{state.current_node_id}"
            TransitionEnum = Enum(enum_name, {key: key for key in transitions.keys()})
            
            # 3. Define the handler function for the tool
            async def transition_to_next_node(context: RunContext, next_intent: TransitionEnum):
                """
                Processes the user's intent and transitions the call to the next node.
                """
                try:
                    chosen_intent = next_intent.value
                    
                    # Validate the chosen intent
                    if chosen_intent not in transitions:
                        logging.warning(f"Invalid intent '{chosen_intent}' for node {state.current_node_id}. Using default transition.")
                        chosen_intent = "default" if "default" in transitions else list(transitions.keys())[0] if transitions else None
                        
                    # If still no valid transition, log error and return
                    if not chosen_intent or chosen_intent not in transitions:
                        logging.error(f"No valid transition found for node {state.current_node_id}.")
                        return "Error: No valid transition found."
                        
                    next_node_id = transitions[chosen_intent]
                    
                    logging.info(f"LLM chose intent '{chosen_intent}', transitioning from '{state.current_node_id}' to '{next_node_id}'.")
                    
                    # Cancel dead air detection before speaking any responses (disabled)
                    # self._cancel_dead_air_detection()
                    
                    # Handle special responses from the conversation context
                    # These are responses that were prepared in _handle_user_response but not yet spoken
                    if 'objection_response' in context.userdata.conversation_context:
                        response = context.userdata.conversation_context['objection_response']
                        del context.userdata.conversation_context['objection_response']
                        response = finalize_agent_text(context.userdata, response, is_objection=True)
                        await self.session.say(response)
                        logging.info(f"Agent said objection response: '{response}'")
                        
                    if 'psp_follow_up_response' in context.userdata.conversation_context:
                        response = context.userdata.conversation_context['psp_follow_up_response']
                        del context.userdata.conversation_context['psp_follow_up_response']
                        response = finalize_agent_text(context.userdata, response, is_objection=True)
                        await self.session.say(response)
                        logging.info(f"Agent said PSP follow-up response: '{response}'")
                        
                    if 'ambiguity_response' in context.userdata.conversation_context:
                        response = context.userdata.conversation_context['ambiguity_response']
                        del context.userdata.conversation_context['ambiguity_response']
                        response = finalize_agent_text(context.userdata, response, is_objection=False)
                        await self.session.say(response)
                        logging.info(f"Agent said ambiguity response: '{response}'")
                    
                    # Update the state
                    context.userdata.current_node_id = next_node_id
                    
                    # Get the next node
                    next_node = nodes.get(next_node_id)
                    if not next_node:
                        logging.error(f"Node '{next_node_id}' not found in call_flow.")
                        return f"Error: Node '{next_node_id}' not found."
                    
                    # Prepare for the next user response
                    await self._prepare_for_user_response(next_node)
                    
                    # Speak the script for the next node
                    script = next_node["script"]
                    # Simple templating for customer_name
                    if context.userdata.customer_name:
                        script = script.replace("{{customer_name}}", context.userdata.customer_name)
                    
                    script = finalize_agent_text(context.userdata, script, is_objection=False)
                    await self.session.say(script)
                    logging.info(f"POST-SAY (tool): len={len(script)} repr={repr(script)}")
                    
                    # Start dead air detection after speaking (disabled)
                    # self._start_dead_air_detection()
                    
                    self.session.clear_user_turn()
                    
                    return f"Successfully transitioned to node {next_node_id}."
                except Exception as e:
                    logging.error(f"Error in transition_to_next_node: {e}", exc_info=True)
                    # Log the error but don't try to recover by restarting the conversation
                    # The session will naturally end if the error is unrecoverable
                    return "Error: Session encountered an unrecoverable error."
 
            # 4. Create the tool programmatically using function_tool as a function
            # This allows us to define the schema dynamically, including the Enum
            tool = function_tool(
                transition_to_next_node,
                name="transition_to_next_node",
                description="Select the user's intent to transition to the next conversational state."
            )
            return tool
        except Exception as e:
            logging.error(f"Error in _create_transition_tool: {e}", exc_info=True)
            # Log the error but don't try to recover by restarting the conversation
            # The session will naturally end if the error is unrecoverable
            async def minimal_transition(context: RunContext):
                logging.warning("Using minimal transition tool due to error in _create_transition_tool")
                return "Error: Session encountered an unrecoverable error in tool creation."
            
            return function_tool(
                minimal_transition,
                name="transition_to_next_node",
                description="Minimal transition tool due to error in _create_transition_tool"
            )
 
    def _check_goal_achievement(self, node_id: str, user_input: str) -> bool:
        """
        Check if the user's response indicates that the goal of the current node has been achieved.
        This is a placeholder and should be implemented with more sophisticated logic.
        """
        # For now, we'll assume the goal is achieved if the user doesn't raise another objection.
        return not self._contains_objection(user_input)
