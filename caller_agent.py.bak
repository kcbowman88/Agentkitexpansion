                    objection_type_enum = self.objection_handler.categorize_objection(user_input, sentiment_score)
                    objection_type_str = getattr(objection_type_enum, "name", str(objection_type_enum))
                    objection_category = getattr(objection_type_enum, "value", str(objection_type_enum))

                    # Record objection in analytics
                    conversation_analytics.record_objection()

                    # Use new API to handle objection; returns ObjectionResponse
                    logging.debug(f"OBJECTION_BRIDGE: node={state.current_node_id} type={objection_type_str} cat={objection_category} tid={state.thread_id}")
                    response_obj = self.objection_handler.handle_objection(
                        thread_id=state.thread_id,
                        node_id=state.current_node_id,
                        objection_category=objection_category,
                        objection_type=objection_type_str,
                        user_utterance=user_input
                    )
                    response = response_obj.response
                    continue_handling = bool(response_obj.context_updated)

                    # If part of a PSP sequence, prepare for follow-up
                    try:
                        if continue_handling and hasattr(self.objection_handler, "early_dismissal_psps"):
                            if response in [psp["turn_1"] for psp in getattr(self.objection_handler, "early_dismissal_psps", {}).values()]:
                                state.conversation_context['pending_psp_followup'] = response
                    except Exception:
                        pass

                    # Finalize objection response; preserve opener invariants
                    resp_final = finalize_agent_text(state, response or "", is_objection=True)
