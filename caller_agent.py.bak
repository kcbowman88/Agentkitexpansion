# --- Response Finalizer: module-level (fixes NameError) ---
RESPONSE_FINALIZER_ENABLED = True
DEBUG_VALIDATORS = False

# Phrases we never want to emit (meta/process/easy-outs)
FINALIZER_DENYLIST = [
    "one quick line", "under 25 seconds", "as a language model",
    "i cannot", "i'm just an ai", "not interested", "no thanks",
    "maybe later", "stop calling", "unsubscribe"
]

# KB template artifacts that must never reach TTS
KB_TEMPLATE_ARTIFACT_TERMS = [
    "works cited", "references:", "bibliography", "citations",
    "now, answer the user’s question directly", "now, answer the user's question directly",
    "answer:", "final answer:", "reference:", "source:"
]

KB_URL_LIKE_PATTERN = r"(?:https?://|www\\.)\\S+"

def _sentence_split(text: str) -> list:
    return [s.strip() for s in re.split(r'[.!?]+', text) if s.strip()]

def _shingles(s: str, n: int = 6) -> set:
    tokens = s.lower().split()
    if len(tokens) < n:
        return set([" ".join(tokens)]) if tokens else set()
    return set([" ".join(tokens[i:i+n]) for i in range(len(tokens)-n+1)])

def _jaccard(a: str, b: str, n: int = 6) -> float:
    sa, sb = _shingles(a, n), _shingles(b, n)
    if not sa and not sb:
        return 0.0
    inter = len(sa & sb)
    union = len(sa | sb) or 1
    return inter / union

def _normalize_plain(s: str) -> str:
    try:
        import string as _string, re as _re
        return s.translate(str.maketrans('', '', _string.punctuation)).lower().strip()
    except Exception:
        return (s or "").lower().strip()

def _sanitize_kb_template_artifacts(text: str) -> str:
    """
    Strip KB template artifacts like 'Works cited', 'Answer:', bibliographic lines, and naked URLs.
    Keep short, conversational content.
    """
    try:
        t = (text or "").strip()
        tl = t.lower()

        # Remove artifact terms anywhere
        if any(term in tl for term in KB_TEMPLATE_ARTIFACT_TERMS):
            # Remove lines that contain artifact terms
            lines = [ln for ln in t.splitlines() if not any(term in ln.lower() for term in KB_TEMPLATE_ARTIFACT_TERMS)]
            t = " ".join([ln.strip() for ln in lines if ln.strip()]).strip()
            tl = t.lower()

        # Remove numbered citation lines like "1) http...", "[1] http...", "- https://.."
        import re
        cleaned_lines = []
        for ln in t.splitlines() if "\n" in t else t.split(". "):
            ln_strip = ln.strip()
            if re.match(r"^(\\s*[\\-\\*]\\s*\\[?\\d+\\]?\\)?\\s*\\S+://)", ln_strip, flags=re.IGNORECASE):
                continue
            if re.match(r"^(\\s*\\d+\\)|\\[\\d+\\])", ln_strip):
                # Likely a citation entry
                continue
            cleaned_lines.append(ln_strip)
        t = " ".join([ln for ln in cleaned_lines if ln]).strip()

        # Remove raw URLs that look like references
        t = re.sub(KB_URL_LIKE_PATTERN, "", t).strip()

        # Collapse extra spaces
        t = re.sub(r"\\s{2,}", " ", t).strip()

        return t or "Let's keep moving."
    except Exception:
        return text

def _sanitize_opener_response(text: str, persona: str = "S") -> str:
    """
    Global last-line opener sanitizer:
      - Composite kill-switch for known verbose PSP: both ('not just any student') AND ('do you mind if i take 20 sec/seconds')
      - Enforce S-tone 'No rush,' + ack-first + pivot-token presence
      - Cap to 3+1 and ensure pivot-last when 4 sentences
    """
    try:
        t = (text or "").strip()
        nl = _normalize_plain(t)

        # Composite kill-switch
        has_student = any(k in nl for k in ("im not just any student","i am not just any student","i’m not just any student"))
        has_20s = any(k in nl for k in (
            "do you mind if i take 20 seconds", "do you mind if i take 20 sec",
            "do you mind if i take 20second", "do you mind if i take 20‑seconds", "do you mind if i take 20–seconds"
        ))
        if has_student and has_20s:
            return "No rush, I hear you. Let's get back to the next step."

        # Neutralize blunt lead
        sents = _sentence_split(t)
        if sents and re.match(r"^\s*let\s+me\s+be\s+blunt\s*$", (sents[0] or "").strip().lower()):
            tail = ". ".join(sents[1:]).strip()
            t = ("I hear you." + (f" {tail}." if tail else "")).strip()
            sents = _sentence_split(t)

        # Ack-first
        ack_tokens = ("i understand", "i hear you", "no worries", "understood", "totally get", "makes sense", "fair point")
        if sents and not any(tok in (sents[0] or "").lower() for tok in ack_tokens):
            t = ("I hear you. " + t).strip()
            sents = _sentence_split(t)

        # Ensure pivot sentence
        pivot_tokens = ("let’s", "let's", "back to", "returning", "bottom line", "quick pivot", "let us")
        has_pivot = any(any(tok in (s or "").lower() for tok in pivot_tokens) for s in sents)
        if not has_pivot:
            t = (t.rstrip(".!?") + ". Let's get back to the next step.").strip()
            sents = _sentence_split(t)

        # Enforce S-tone for opener family by default
        if (persona or "S").upper() == "S" and not t.strip().startswith("No rush,"):
            t = "No rush, " + t

        # Cap to 3+1 with pivot-last when 4
        sents = _sentence_split(t)
        if len(sents) > 4:
            sents = sents[:3] + [sents[-1]]
        if len(sents) == 4 and not any(tok in (sents[-1] or "").lower() for tok in pivot_tokens):
            # Move/synthesize pivot to last
            pidx = next((i for i, s in enumerate(sents) if any(tok in (s or "").lower() for tok in pivot_tokens)), -1)
            if pidx >= 0 and pidx != 3:
                pivot_sent = sents[pidx]
                base = [s for j, s in enumerate(sents[:3]) if j != pidx]
                sents = base[:3] + [pivot_sent]
            else:
                sents = sents[:3] + ["Let's get back to the next step."]
            t = ". ".join([s.rstrip(".") for s in sents]) + "."

        # Final composite check again post-shaping (defensive)
        nl2 = _normalize_plain(t)
        if any(k in nl2 for k in ("im not just any student","i am not just any student","i’m not just any student")) and \
           any(k in nl2 for k in ("do you mind if i take 20 seconds","do you mind if i take 20 sec","do you mind if i take 20second","do you mind if i take 20‑seconds","do you mind if i take 20–seconds")):
            return "No rush, I hear you. Let's get back to the next step."

        return t
    except Exception:
        return text

def finalize_agent_text(state, text: str, *, is_objection: bool = False) -> str:
    """
    Enforce denylist, anti-repetition (exact + 6-gram near-dup), and sentence cap for objections.
    Updates state.agent_utterance_history upon acceptance.
    """
    try:
        if not RESPONSE_FINALIZER_ENABLED:
            if isinstance(getattr(state, "agent_utterance_history", None), list):
                state.agent_utterance_history.append(text)
            return text

        t = (text or "").strip()
        tl = t.lower()

        # Last-mile KB artifact sanitize on all outputs
        t = _sanitize_kb_template_artifacts(t)
        tl = t.lower()

        # Denylist block
        if any(term in tl for term in FINALIZER_DENYLIST):
            t = "Let’s keep moving."

        # Opener objection hard guard: never offer callbacks/scheduling language from opener
        try:
            node_id_guard = getattr(state, "current_node_id", "") or ""
            if is_objection and node_id_guard == "N_Opener_StackingIncomeHook_V3_CreativeTactic":
                # phrases that imply scheduling/callbacks or off-channel routes we disallow at opener
                opener_callback_scheduling_deny = [
                    "call you back", "call me back", "call back", "ring you later", "ring me later",
                    "later today", "some other time", "another time", "schedule", "reschedule",
                    "book a time", "set up a time", "text you the link", "text me the link",
                    "email you", "send an email", "send you an email", "shoot you a text"
                ]
                if any(p in tl for p in opener_callback_scheduling_deny):
                    print("DEBUG: opener_guard_callback_scheduling_denied")
                    # Replace with neutral momentum-preserving line without changing node flow
                    t = "Understood. Let’s keep momentum."
                    tl = t.lower()
        except Exception:
            pass

        # Objection-global composite kill-switch and opener invariants (post-failure strategy v4)
        try:
            def _normalize_plain_local(s: str) -> str:
                import string as _string
                return (s or "").translate(str.maketrans('', '', _string.punctuation)).lower().strip()
            nl0 = _normalize_plain_local(t)
            has_student = any(k in nl0 for k in ("im not just any student","i am not just any student","i’m not just any student"))
            has_20s = any(k in nl0 for k in ("do you mind if i take 20 seconds","do you mind if i take 20 sec","do you mind if i take 20second","do you mind if i take 20‑seconds","do you mind if i take 20–seconds"))
            if is_objection and has_student and has_20s:
                print("DEBUG: finalize_agent_text_killswitch_objection_composite")
                t = "No rush, I hear you. Let's get back to the next step."
                tl = t.lower()
        except Exception:
            pass

        # Sentence cap and guards for objection turns (pivot-aware 3+1 policy + ack/pivot enforcement)
        sents = _sentence_split(t)
        if is_objection:
            # If opener-family, enforce S-tone prefix early based on current node, if available
            try:
                node_id = getattr(state, "current_node_id", "") or ""
                if node_id in ("N_Opener_StackingIncomeHook_V3_CreativeTactic",
                               "N_IntroduceModel_And_AskQuestions_V3_Adaptive",
                               "N_IntroduceModel_And_AskQuestions_V3_Adaptive_Steady"):
                    if not t.strip().startswith("No rush,"):
                        t = ("No rush, " + t) if t else "No rush, I hear you. Let's get back to the next step."
                        sents = _sentence_split(t)
            except Exception:
                pass
            ack_tokens = ("i understand", "i hear you", "no worries", "understood", "totally get", "makes sense", "fair point")
            pivot_tokens = ("let’s", "let's", "back to", "returning", "bottom line", "quick pivot", "let us")

            # Normalize leading "Let me be blunt." to ack-first
            try:
                _raw_sents = list(sents)
                if _raw_sents and re.match(r"^\s*let\s+me\s+be\s+blunt\s*$", (_raw_sents[0] or "").strip().lower()):
                    tail = ". ".join(_raw_sents[1:]).strip()
                    t = ("I hear you." + (f" {tail}." if tail else "")).strip()
                    sents = _sentence_split(t)
            except Exception:
                pass

            # Ensure first sentence contains acknowledgment
            try:
                if sents and not any(tok in (sents[0] or "").lower() for tok in ack_tokens):
                    t = ("I hear you. " + t).strip()
                    sents = _sentence_split(t)
            except Exception:
                pass

            # Ensure at least one pivot/transition token exists; if absent, append a compliant pivot sentence
            has_pivot = any(any(tok in (s or "").lower() for tok in pivot_tokens) for s in sents)
            if not has_pivot:
                t = (t.rstrip(".!?") + ". Let's get back to the next step.").strip()
                sents = _sentence_split(t)

            # Enforce 3+1 cap with pivot last when 4 sentences
            if len(sents) > 4:
                # keep first 3 substantive + last (which may or may not be pivot; we will fix below)
                sents = sents[:3] + [sents[-1]]
            if len(sents) == 4:
                # make sure last has pivot token; if not, relocate or synthesize
                if not any(tok in (sents[-1] or "").lower() for tok in pivot_tokens):
                    # find a pivot-bearing sentence among first 4
                    pivot_idx = None
                    for i in range(3, -1, -1):
                        if any(tok in (sents[i] or "").lower() for tok in pivot_tokens):
                            pivot_idx = i
                            break
                    if pivot_idx is not None:
                        pivot_sent = sents[pivot_idx]
                        base = [s for j, s in enumerate(sents[:3]) if j != pivot_idx]
                        sents = base[:3] + [pivot_sent]
                    else:
                        sents = sents[:3] + ["Let's get back to the next step."]

            # Recompose objection text
            t = ". ".join([s.rstrip(".") for s in sents]) + "."
        else:
            # non-objection path unchanged
            pass

        # Within-turn repetition: drop duplicate sentences
        if len(sents) > 1:
            dedup = []
            seen = set()
            for s in sents:
                if s.lower() in seen:
                    continue
                seen.add(s.lower())
                dedup.append(s)
            if len(dedup) != len(sents):
                t = ". ".join(dedup) + "."

        # Cross-turn repetition: exact and near-dup vs last K utterances
        history = getattr(state, "agent_utterance_history", []) or []
        K = 6
        recent = history[-K:]
        # When objection with pivot tokens, avoid replacing entire text with generic anti-repeat lines (preserve pivot)
        has_pivot_global = False
        if is_objection:
            try:
                pivot_tokens = ("let’s", "let's", "back to", "returning", "bottom line", "quick pivot", "let us")
                parts_tmp = _sentence_split(t)
                has_pivot_global = any(any(tok in (s or "").lower() for tok in pivot_tokens) for s in parts_tmp)
            except Exception:
                has_pivot_global = False
        for prev in recent:
            if t.strip().lower() == prev.strip().lower():
                if not has_pivot_global:
                    t = "Understood. Let’s keep momentum."
                break
            if _jaccard(t, prev, n=6) > 0.6:
                if not has_pivot_global:
                    t = "Got it. Moving forward."
                break

        if not t:
            t = "Let’s keep moving."

        if isinstance(getattr(state, "agent_utterance_history", None), list):
            state.agent_utterance_history.append(t)

        if DEBUG_VALIDATORS:
            logging.debug(f"FINALIZER_OUT: {t}")

        return t
    except Exception as e:
        logging.error(f"finalize_agent_text error: {e}", exc_info=True)
        try:
            if isinstance(getattr(state, "agent_utterance_history", None), list):
                state.agent_utterance_history.append(text)
        except Exception:
            pass
        return text

# --- State Management ---
@dataclass
class CallFlowState:
    """Manages the state of the conversation flow."""
    customer_name: Optional[str] = None
    current_node_id: str = "N001A_NameConfirmation_Only"
    
    # Enhanced state variables
    personality_type: Optional[str] = None  # DISC personality type (D, I, S, C)
    emotional_state: Optional[str] = None  # Emotional state (positive, negative, neutral)
    objection_history: list = field(default_factory=list)  # Track user objections
    conversation_context: dict = field(default_factory=dict)  # Track conversation context
    user_preferences: dict = field(default_factory=dict)  # Track user preferences
    tactic_history: list = field(default_factory=list)  # Track used tactics to prevent repetition
    appointment_details: dict = field(default_factory=dict)  # Track appointment details
    qualification_status: dict = field(default_factory=dict)  # Track qualification progress
    conversation_history: list = field(default_factory=list)  # Track conversation history for memory
    # A2: stable thread_id for AB-guard hashing and deterministic rotation
    thread_id: Optional[str] = None
    # New flag to manage the state after an objection
    waiting_for_objection_response: bool = False
    node_goal_achieved: bool = False
    objection_loop_counter: int = 0
    # Finalizer history for anti-repetition and gating
    agent_utterance_history: list = field(default_factory=list)
    
# --- Agent Registry (Simplified) ---
AGENT_REGISTRY: dict = {}

def register_agent(node_id: str):
    """Decorator to register an agent class for a specific node_id."""
    def decorator(cls: Type[Agent]):
        AGENT_REGISTRY[node_id] = cls
        return cls
    return decorator

# --- The Unified Call Flow Agent ---
class CallFlowAgent(Agent):
    """
    A single, unified agent that drives the entire call flow.
    Its behavior is determined by the current_node_id in the CallFlowState.
    """

    def __init__(self, instructions: str = ""):
        # The agent's instructions and tools will be updated dynamically each turn.
        super().__init__(instructions=instructions)
        
        # Initialize enhanced components
        self.disc_classifier = DISCClassifier()
        # Initialize ObjectionHandler with a default persona, which will be updated later
        # The persona will be dynamically updated from state.personality_type during handling
        self.objection_handler = ObjectionHandler(persona="S") # Default to 'S' (Steady)
        self.tactical_responder = TacticalResponder()
        self.kb_processor = KBProcessor()
        
        # Initialize session attribute to make it settable
        self._session = None
        
        # Dead air handling (disabled)
        # self.dead_air_timeout = 5.0  # seconds
        # self.dead_air_task = None
        
        logging.info("CallFlowAgent initialized with enhanced features.")
    @property
    def session(self):
        return self._session
    
    @session.setter
    def session(self, value):
        self._session = value
    
    def _fallback_transition(self, state: CallFlowState, user_input: str) -> Optional[str]:
        """
        Sophisticated fallback mechanism for unhandled inputs
        
        Args:
            state (CallFlowState): The current conversation state
            user_input (str): The user's input
            
        Returns:
            Optional[str]: The ID of the next node to transition to, or None if no fallback available
        """
        try:
            logging.warning(f"Using fallback transition for input: {user_input}")
            
            # Analyze the user input to determine the best fallback strategy
            sentiment_score = state.conversation_context.get('sentiment', {}).get('score', 0.0)
            personality_type = state.personality_type or "S"
            
            # Check for specific keywords in the input
            user_input_lower = user_input.lower()
            
            # If user is asking a question, try to answer it
            if any(word in user_input_lower for word in ['what', 'how', 'why', 'when', 'where', 'explain']):
                # Try to transition to a Q&A node
                if 'N_KB_Q&A_With_StrategicNarrative_V3_Adaptive' in nodes:
                    logging.info("Attempting to transition to KB Q&A node")
                    return 'N_KB_Q&A_With_StrategicNarrative_V3_Adaptive'
                    
            # If user seems confused or unsure, provide clarification
            if sentiment_score < -0.3 or any(word in user_input_lower for word in ['confused', 'unclear', 'not sure', 'huh', 'what']):
                # Try to transition to a clarification node
                if 'N_Obj_EarlyDismiss_AskShareBackground_V7' in nodes:
                    return 'N_Obj_EarlyDismiss_AskShareBackground_V7'
                    
            # If user is showing interest, try to engage further
            if sentiment_score > 0.3 or any(word in user_input_lower for word in ['interested', 'tell me more', 'sounds good']):
                # Try to transition to an engagement node
                if 'N_IntroduceModel_And_AskQuestions_V3_Adaptive' in nodes:
                    return 'N_IntroduceModel_And_AskQuestions_V3_Adaptive'
                    
            # For Dominant personalities, be direct
            if personality_type == "D":
                if 'N_IntroduceModel_And_AskQuestions_V3_Adaptive_Dominant' in nodes:
                    return 'N_IntroduceModel_And_AskQuestions_V3_Adaptive_Dominant'
                    
            # For Influential personalities, be engaging
            if personality_type == "I":
                if 'N_IntroduceModel_And_AskQuestions_V3_Adaptive_Influential' in nodes:
                    return 'N_IntroduceModel_And_AskQuestions_V3_Adaptive_Influential'
                    
            # For Steady personalities, be patient
            if personality_type == "S":
                if 'N_IntroduceModel_And_AskQuestions_V3_Adaptive_Steady' in nodes:
                    return 'N_IntroduceModel_And_AskQuestions_V3_Adaptive_Steady'
                    
            # For Conscientious personalities, be detailed
            if personality_type == "C":
                if 'N_IntroduceModel_And_AskQuestions_V3_Adaptive_Conscientious' in nodes:
                    return 'N_IntroduceModel_And_AskQuestions_V3_Adaptive_Conscientious'
                    
            # If all else fails, try to get back on track with the main flow
            conversation_history = state.conversation_history
            if conversation_history:
                # Look at the last few nodes visited to determine where to go next
                recent_nodes = [entry.get('node_id') for entry in conversation_history[-10:] if entry.get('node_id')]
                if recent_nodes:
                    # Try to find a node that comes after one of the recent nodes
                    for node_id in recent_nodes:
                        node = nodes.get(node_id)
                        if node and 'default' in node.get('transitions', {}):
                            return node['transitions']['default']
                            
            # Ultimate fallback - go back to the introduction
            return 'N001A_NameConfirmation_Only'
        except Exception as e:
            logging.error(f"Error in _fallback_transition: {e}", exc_info=True)
            # Ultimate fallback - go back to the introduction
            return 'N001A_NameConfirmation_Only'
    
    def _summarize_conversation_context(self, state: CallFlowState) -> str:
        """
        Summarize the conversation history for context-aware responses
        
        Args:
            state (CallFlowState): The current conversation state
            
        Returns:
            str: A summary of the conversation context
        """
        try:
            if not state.conversation_history:
                return "No previous conversation history."
            
            # Get the last 5 exchanges (user and agent)
            recent_exchanges = state.conversation_history[-10:]  # Last 5 exchanges (2 messages each)
            
            summary = "Recent conversation context:\n"
            for exchange in recent_exchanges:
                speaker = exchange.get('speaker', 'unknown')
                text = exchange.get('text', '')
                summary += f"- {speaker}: {text}\n"
                
            # Add personality and emotional insights
            if state.personality_type:
                summary += f"\nUser personality type: {state.personality_type}\n"
                
            if state.emotional_state:
                summary += f"User emotional state: {state.emotional_state}\n"
                
            # Add qualification status
            if state.qualification_status:
                summary += f"\nQualification status: {state.qualification_status}\n"
                
            return summary
        except Exception as e:
            logging.error(f"Error in _summarize_conversation_context: {e}", exc_info=True)
            return "Error summarizing conversation context."
    
    def _update_qualification_status(self, state: CallFlowState, user_input: str):
        """
        Update qualification status based on user input and conversation history
        
        Args:
            state (CallFlowState): The current conversation state
            user_input (str): The user's response
        """
        try:
            # Initialize qualification status if not present
            if not state.qualification_status:
                state.qualification_status = {
                    'engagement_level': 0,  # 0-10 scale
                    'understanding_level': 0,  # 0-10 scale
                    'goal_alignment': 0,  # 0-10 scale
                    'financial_readiness': 0,  # 0-10 scale
                    'overall_score': 0  # 0-10 scale
                }
            
            # Update engagement level based on response length and sentiment
            response_length = len(user_input.split())
            sentiment_score = state.conversation_context.get('sentiment', {}).get('score', 0.0)
            
            if response_length > 20:
                state.qualification_status['engagement_level'] = min(10, state.qualification_status['engagement_level'] + 2)
            elif response_length > 10:
                state.qualification_status['engagement_level'] = min(10, state.qualification_status['engagement_level'] + 1)
            elif response_length < 5 and sentiment_score < -0.3:
               state.qualification_status['engagement_level'] = max(0, state.qualification_status['engagement_level'] - 1)
               
            # Update understanding level based on questions asked
            question_indicators = ['what', 'how', 'why', 'when', 'where', 'explain', 'tell me']
            question_count = sum(1 for indicator in question_indicators if indicator in user_input.lower())
            
            if question_count > 2:
                state.qualification_status['understanding_level'] = min(10, state.qualification_status['understanding_level'] + 2)
            elif question_count > 0:
                state.qualification_status['understanding_level'] = min(10, state.qualification_status['understanding_level'] + 1)
                
            # Update goal alignment based on keywords
            goal_keywords = ['income', 'money', 'earn', 'make', 'passive', 'business', 'opportunity']
            goal_matches = sum(1 for keyword in goal_keywords if keyword in user_input.lower())
            
            if goal_matches > 3:
                state.qualification_status['goal_alignment'] = min(10, state.qualification_status['goal_alignment'] + 2)
            elif goal_matches > 0:
                state.qualification_status['goal_alignment'] = min(10, state.qualification_status['goal_alignment'] + 1)
                
            # Update financial readiness based on financial keywords
            financial_keywords = ['capital', 'money', 'invest', 'budget', 'expense', 'cost', 'afford']
            financial_matches = sum(1 for keyword in financial_keywords if keyword in user_input.lower())
            
            if financial_matches > 2:
                state.qualification_status['financial_readiness'] = min(10, state.qualification_status['financial_readiness'] + 2)
            elif financial_matches > 0:
                state.qualification_status['financial_readiness'] = min(10, state.qualification_status['financial_readiness'] + 1)
                
            # Calculate overall score as average of all factors
            state.qualification_status['overall_score'] = (
                state.qualification_status['engagement_level'] +
                state.qualification_status['understanding_level'] +
                state.qualification_status['goal_alignment'] +
                state.qualification_status['financial_readiness']
            ) / 4
            
            logging.info(f"Updated qualification status: {state.qualification_status}")
        except Exception as e:
            logging.error(f"Error in _update_qualification_status: {e}", exc_info=True)
            # Continue with default qualification status
            if not state.qualification_status:
                state.qualification_status = {
                    'engagement_level': 5,
                    'understanding_level': 5,
                    'goal_alignment': 5,
                    'financial_readiness': 5,
                    'overall_score': 5
                }
    
    def _analyze_sentiment(self, text: str) -> float:
        """
        Simple sentiment analysis based on keyword matching.
        
        Args:
            text (str): The text to analyze
            
        Returns:
            float: Sentiment score from -1 (negative) to 1 (positive)
        """
        try:
            # Simple keyword-based sentiment analysis
            positive_words = [
                "good", "great", "excellent", "amazing", "wonderful", "fantastic",
                "love", "like", "enjoy", "happy", "pleased", "satisfied", "excited",
                "interested", "curious", "fascinating", "intriguing", "promising"
            ]
            
            negative_words = [
                "bad", "terrible", "awful", "horrible", "hate", "dislike", "angry",
                "frustrated", "annoyed", "disappointed", "concerned", "worried",
                "skeptical", "doubtful", "uncertain", "confused", "unsure"
            ]
            
            # Normalize text
            text_lower = text.lower()
            
            # Count positive and negative words
            positive_count = sum(1 for word in positive_words if word in text_lower)
            negative_count = sum(1 for word in negative_words if word in text_lower)
            
            # Calculate sentiment score
            total_emotional_words = positive_count + negative_count
            if total_emotional_words == 0:
                return 0.0  # Neutral sentiment
            
            sentiment_score = (positive_count - negative_count) / total_emotional_words
            return sentiment_score
        except Exception as e:
            logging.error(f"Error in _analyze_sentiment: {e}", exc_info=True)
            return 0.0  # Neutral sentiment as fallback
            
    async def on_enter(self):
        """
        Entry point for each state in the call flow.
        This method is called when the agent starts and after every successful transition.
        """
        try:
            # This method is kept for backward compatibility with the existing node transition system
            state: CallFlowState = self.session.userdata
            current_node = nodes.get(state.current_node_id)
            
            if not current_node:
                logging.error(f"Node '{state.current_node_id}' not found in call_flow. Closing session.")
                await self.session.close()
                return
            
            logging.info(f"Entering node: {state.current_node_id}")
            
            # 1. Speak the script for the current node
            script = current_node["script"]
            # Simple templating for customer_name
            if state.customer_name:
                script = script.replace("{{customer_name}}", state.customer_name)
            
            # Check if session is properly initialized before speaking
            if self.session is None:
                logging.error("Session is not initialized")
                return
                
            # Check if STT is available
            if self.session.stt is None:
                logging.warning("STT is not available. Agent may not be able to process user input.")
                
            # Finalize scripted output before saying it
            script = finalize_agent_text(state, script, is_objection=False)
            await self.session.say(script)
            logging.info(f"Agent said: '{script}'")
            
            # 2. Start dead air detection after speaking (disabled)
            # self._start_dead_air_detection()
            
            # 3. Wait for user response before transitioning
            # The transition will happen in the _handle_user_response method
            # when the user provides input and the LLM selects a transition
        except Exception as e:
            logging.error(f"Error in on_enter: {e}", exc_info=True)
            # Log the error but don't try to recover by restarting the conversation
            # The session will naturally end if the error is unrecoverable

    async def on_user_turn_completed(self, turn_ctx: llm.ChatContext, new_message: llm.ChatMessage) -> None:
        """
        Called when the user has finished speaking.
        
        Args:
            turn_ctx (llm.ChatContext): The context for the LLM (the conversation history).
            new_message (llm.ChatMessage): The new message from the user.
        """
        try:
            # Check if session is properly initialized
            if self.session is None:
                logging.error("Session is not initialized in on_user_turn_completed")
                return
                
            # Get the user's input from the new message
            user_input = ""
            if new_message.content:
                if isinstance(new_message.content, list):
                    # If content is a list, join all elements into a single string
                    user_input = " ".join(str(item) for item in new_message.content)
                else:
                    # If content is already a string, use it as is
                    user_input = str(new_message.content)
            
            # Get the current state
            state: CallFlowState = self.session.userdata
            
            # Ensure thread_id is set once for the conversation (stable)
            if not state.thread_id:
                try:
                    # Prefer a stable session id if available; else derive a pseudo-id from customer_name+start_time
                    sess = getattr(self, "session", None)
                    sid = getattr(sess, "id", None) if sess else None
                    state.thread_id = str(sid) if sid else f"thread::{state.customer_name or 'user'}::{int(time.time())}"
                except Exception:
                    state.thread_id = f"thread::{state.customer_name or 'user'}"
            
            # Handle the user's response
            await self._handle_user_response(user_input, state)
        except Exception as e:
            logging.error(f"Error in on_user_turn_completed: {e}", exc_info=True)
            # Log the error but don't try to recover by restarting the conversation
            # The session will naturally end if the error is unrecoverable

