    def _should_invoke_kb(self, state: "CallFlowState", user_input: str) -> bool:
        """
        Gate KB usage. Only allow when user explicitly asks company/about/legitimacy/brand questions
        or raises company-based objections. Block during opener-family objections by default.
        # One-shot bypass: if force_kb_once is set (from IntroduceModel inline company-intent),
        # consume it and bypass gating for this turn.
        try:
            if bool(getattr(state, "conversation_context", {}).pop("force_kb_once", False)):
                logging.info("KB_INLINE: force_kb_once consumed; kb_forced_transition=true; bypassing KB gating this turn.")
                state.conversation_context["kb_forced_transition"] = True
                return True
        except Exception:
            pass
        """
        try:
            nl = (user_input or "").lower().strip()
            node = getattr(state, "current_node_id", "") or ""
            # Block in opener-family unless clearly company-directed
            opener_family = {
                "N_Opener_StackingIncomeHook_V3_CreativeTactic",
                "N_IntroduceModel_And_AskQuestions_V3_Adaptive",
                "N_IntroduceModel_And_AskQuestions_V3_Adaptive_Steady",
            }
            company_terms = [
                "company", "about you", "who are you", "who is this", "what do you guys do",
                "are you legit", "is this legit", "is this a scam", "scam", "legit", "legitimate",
                "ippei", "domain", "website", "site", "brand", "about your company", "about your program",
                "where can i read about you", "reviews", "testimonials"
            ]
            has_company_intent = any(term in nl for term in company_terms)
            # If in opener-family, require explicit company intent
            if node in opener_family:
                return has_company_intent
            # Elsewhere, allow KB when company intent OR explicit factual request likely needing KB
            factual_terms = ["according to", "source", "evidence", "proof", "data", "stats", "statistics"]
            return has_company_intent or any(term in nl for term in factual_terms)
        except Exception:
            return False

    def _is_company_intent(self, text: str) -> bool:
        """
        Lightweight detector for company/legitimacy/factual intent to trigger KB inline answers.
    async def _maybe_inline_company_kb(self, state: "CallFlowState", user_input: str) -> bool:
        """
        If at IntroduceModel node and the user asks about the company/legitimacy/brand,
        immediately:
          1) speak a concise one-liner from KB (or fallback),
          2) force-transition to KB Q&amp;A node,
          3) speak KB node content in the same turn (handled by _transition_to_node via force_kb_once flag).
        Returns True if handled inline.
        """
        try:
            node_id = getattr(state, "current_node_id", "") or ""
            is_intro = node_id.startswith("N_IntroduceModel_And_AskQuestions")
            if not is_intro:
                return False

            if not self._is_company_intent(user_input):
                return False

            # Compose concise company line (KB snippet if available)
            persona = (state.personality_type or "S").upper()
            ack = {
                "D": "Quick background:",
                "I": "Totally—quick background:",
                "S": "Gotcha—quick background:",
                "C": "Brief background:"
            }.get(persona, "Quick background:")

            snippet = None
            try:
                snippet = get_concise_snippet(
                    node_id="KB_QA",
                    topic="company_overview",
                    persona_or_none=persona,
                    seed_keys=(state.thread_id or "tid", node_id, "inline_company")
                )
            except Exception:
                snippet = None

            kb_line = (snippet or {}).get("text") or "We run a training and support program that teaches the rank-and-bank digital real estate model, with a large student base and strong track record."
            inline_msg = f"{ack} {kb_line}"

            # mark flags for analytics/handling
            state.conversation_context["kb_inline_used"] = True
            state.conversation_context["kb_forced_transition"] = True
            state.conversation_context["force_kb_once"] = True

            # speak the inline line now
            inline_msg = finalize_agent_text(state, inline_msg, is_objection=False)
            await self.session.say(inline_msg)
            logging.info("kb_inline_used=true msg_spoken")

            # immediately route to KB node; _transition_to_node will honor force_kb_once
            await self._transition_to_node("N_KB_Q&amp;A_With_StrategicNarrative_V3_Adaptive")
            return True
        except Exception as e:
            logging.error(f"_maybe_inline_company_kb error: {e}", exc_info=True)
            return False
        This is intentionally broader than _should_invoke_kb gating logic.
    async def _maybe_inline_company_and_route_kb(self, user_input: str, state: "CallFlowState") -> bool:
        """
        If we're at IntroduceModel and the user expresses company/legitimacy intent,
        speak a concise company snippet inline, then immediately transition to KB Q&A
        and speak that script in the same turn (no waiting for user).
        """
        try:
            if state.current_node_id not in (
                "N_IntroduceModel_And_AskQuestions_V3_Adaptive",
                "N_IntroduceModel_And_AskQuestions_V3_Adaptive_Steady",
            ):
                return False

            if not self._is_company_intent(user_input):
                return False

            persona = (state.personality_type or "S").upper()
            # Try to fetch a concise snippet; fall back to a safe one-liner
            sn = None
            try:
                sn = get_concise_snippet(
                    node_id="N_IntroduceModel_And_AskQuestions_V3_Adaptive",
                    topic="company",
                    persona_or_none=persona,
                    seed_keys=(state.customer_name or "", state.thread_id or "")
                )
            except Exception:
                sn = None

            snippet_text = (sn or {}).get("text") or "We build and rank local lead-gen sites, then partner with reputable businesses to monetize the inbound leads."

            # Compose ≤2-sentence inline ack + snippet (no meta narration)
            inline_msg = f"Totally. Quick background: {snippet_text}"
            inline_msg = finalize_agent_text(state, inline_msg, is_objection=False)
            await self.session.say(inline_msg)
            logging.info("kb_inline_used=true | node=IntroduceModel | persona=%s | snippet_id=%s",
                         persona, (sn or {}).get("id"))

            # Force KB once: bypass gating on next node so we speak KB now
            state.conversation_context["force_kb_once"] = True
            state.conversation_context["kb_forced_transition_reason"] = "company_intent_at_introduce_model"
            logging.info("kb_forced_transition=true | reason=company_intent_at_introduce_model")

            # Immediately route to KB and speak dynamic KB script in same turn
            await self._transition_to_node("N_KB_Q&A_With_StrategicNarrative_V3_Adaptive")
            return True
        except Exception as e:
            logging.error(f"_maybe_inline_company_and_route_kb error: {e}", exc_info=True)
            return False
        """
        try:
            nl = (text or "").lower().strip()
            if not nl:
                return False
            company_terms = [
                "company", "about you", "who are you", "who is this", "what do you guys do",
                "are you legit", "is this legit", "is this a scam", "scam", "legit", "legitimate",
                "ippei", "domain", "website", "site", "brand", "about your company", "about your program",
                "where can i read about you", "reviews", "testimonials"
            ]
            # Also treat soft legitimacy probes as company intent
            soft_trust = ["what's the catch", "whats the catch", "is this for real"]
            factual_terms = ["according to", "source", "evidence", "proof", "data", "stats", "statistics"]
            return any(term in nl for term in (company_terms + soft_trust + factual_terms))
        except Exception:
            return False
    async def _handle_objection(self, user_input: str, state: "CallFlowState"):
        """
        Bridge method to handle objections during live console runs.
        Delegates to ObjectionHandler and preserves opener invariants and routing behavior
        consistent with the harness path inside _handle_user_response.
        """
        try:
            # Guard: sentiment and emotional state
            sentiment_score = state.conversation_context.get('sentiment', {}).get('score', 0.0)
            emotional_state = state.emotional_state or "neutral"

            # Categorize objection
            objection_type_enum = self.objection_handler.categorize_objection(user_input, sentiment_score)
            objection_type_str = objection_type_enum.name # Get the string name of the enum member
            objection_category = objection_type_enum.value # Get the string value of the enum member

            # Record analytics/history
            conversation_analytics.record_objection()
            # The add_to_history method in ObjectionHandler needs to be updated to accept new parameters
            # For now, we will skip adding to history if it relies on the old Objection object.
            # self.objection_handler.add_to_history(objection, state)

            # Handle objection with enhanced parameters including current node and thread id
            response_obj = self.objection_handler.handle_objection(
                thread_id=state.thread_id,
                node_id=state.current_node_id,
                objection_category=objection_category,
                objection_type=objection_type_str,
                user_utterance=user_input
            )
            response = response_obj.response
            continue_handling = response_obj.context_updated # Use context_updated to determine if handling continues

            # Mark PSP follow-up expectation if applicable
            try:
                if continue_handling and response in [psp["turn_1"] for psp in self.objection_handler.early_dismissal_psps.values()]:
                    state.conversation_context['pending_psp_followup'] = response
            except Exception:
                pass

            # Finalize and sanitize opener-family objection text
            resp_final = finalize_agent_text(state, response or "", is_objection=True)
            try:
                persona = (state.personality_type or "S").upper()
                if state.current_node_id in (
                    "N_Opener_StackingIncomeHook_V3_CreativeTactic",
                    "N_IntroduceModel_And_AskQuestions_V3_Adaptive",
                    "N_IntroduceModel_And_AskQuestions_V3_Adaptive_Steady",
                ):
                    resp_final = _sanitize_opener_response(resp_final, persona=persona)
                    print("DEBUG: caller_agent_opener_sanitize_fired")
            except Exception:
                pass

            # Speak the objection response
            await self.session.say(resp_final)
            logging.info(f"Agent said objection response: '{resp_final}'")

            # Opener-specific: immediate route without speaking next node script
            if state.current_node_id == "N_Opener_StackingIncomeHook_V3_CreativeTactic":
                trans_key = self._get_content_based_transition(state.current_node_id, user_input)
                current_node_def = nodes.get(state.current_node_id) or {}
                trans_map = current_node_def.get("transitions", {}) or {}
                priority = []
                if trans_key:
                    priority.append(trans_key)
                priority.extend([
                    "not_interested",
                    "no_time",
                    "objection_or_callback_request",
                    "no_recall",
                    "question",
                    "permission_granted",
                    "default",
                ])
                for key in priority:
                    if key in trans_map:
                        state.conversation_context["suppress_next_say"] = True
                        await self._transition_to_node(trans_map[key])
                        return
                # If no transition found, fall back to normal objection wait
                state.waiting_for_objection_response = True
                return

            # Non-opener: wait for user response on same node
            state.waiting_for_objection_response = True
            return
        except Exception as e:
            logging.error(f"_handle_objection bridge error: {e}", exc_info=True)
            # As a fallback, avoid breaking the session; try to keep flow moving
            try:
                resp = finalize_agent_text(state, "Understood. Let's keep momentum.", is_objection=True)
                await self.session.say(resp)
            except Exception:
                pass
            state.waiting_for_objection_response = True
            return

    async def _handle_user_response(self, user_input: str, state: CallFlowState):
        """
        Handle user response with enhanced features
        
        Args:
            user_input (str): The user's response
            state (CallFlowState): The current conversation state
        """
        try:
            # If we were waiting for an objection response, check if the goal is now achieved
            if state.waiting_for_objection_response:
                state.waiting_for_objection_response = False # Reset the flag
                state.node_goal_achieved = self._check_goal_achievement(state.current_node_id, user_input)

                if not state.node_goal_achieved:
                    state.objection_loop_counter += 1
                    # If user responds with another objection, handle it
                    if self._contains_objection(user_input):
                        if state.objection_loop_counter > 2: # Prevent infinite loops
                            logging.warning("Objection loop detected, transitioning to fallback.")
                            next_node_id = self._fallback_transition(state, user_input)
                            if next_node_id:
                                await self._transition_to_node(next_node_id)
                            return
                        else:
                            # Handle the new objection
                            await self._handle_objection(user_input, state)
                            return
                    else:
                        # Re-engage the user on the same topic
                        re_engagement_prompt = f"I understand, but just to be clear, {nodes[state.current_node_id]['script']}"
                        await self.session.say(re_engagement_prompt)
                        state.waiting_for_objection_response = True # Wait for another response
                        return
                else:
                    state.objection_loop_counter = 0 # Reset loop counter

            # Cancel dead air detection when user responds (disabled)
            # self._cancel_dead_air_detection()
            
            # If we don't have user input and STT is not available, simulate input
            if not user_input and (not hasattr(self.session, 'stt') or self.session.stt is None):
                logging.warning("No user input received and STT is not available. Simulating user response.")
                user_input = "Yes"  # Default response
            
            # Add user input to conversation history
            state.conversation_history.append({
                'speaker': 'user',
                'text': user_input,
                'timestamp': time.time(),
                'node_id': state.current_node_id,
                'personality_type': state.personality_type,
                'emotional_state': state.emotional_state,
                'sentiment_score': state.conversation_context.get('sentiment', {}).get('score', 0.0)
            })
            
            # Track user questions and interests for personalization
            self._track_user_preferences(state, user_input)
            
            # Inline company-intent handler at IntroduceModel: speak ack+KB snippet and immediately move to KB node
            try:
                if state.current_node_id in (
                    "N_IntroduceModel_And_AskQuestions_V3_Adaptive",
                    "N_IntroduceModel_And_AskQuestions_V3_Adaptive_Steady",
                    "N_IntroduceModel_And_AskQuestions_V3_Adaptive_Dominant",
                    "N_IntroduceModel_And_AskQuestions_V3_Adaptive_Influential",
                    "N_IntroduceModel_And_AskQuestions_V3_Adaptive_Conscientious",
                    "N_IntroduceModel_And_AskQuestions_V3_Adaptive_HighEngagement",
                ) and self._is_company_intent(user_input) and not state.waiting_for_objection_response:
                    logging.info("kb_inline_used=True at IntroduceModel; composing concise company overview and forcing KB transition")
                    persona = (state.personality_type or "S").upper()
                    # Try persona-specific snippet; fallback to persona=None; then generic
                    snippet_obj = get_concise_snippet(node_id="KB_QA", topic="company", persona_or_none=persona, seed_keys=(state.customer_name or "", "company", persona)) \
                                  or get_concise_snippet(node_id="KB_QA", topic="company", persona_or_none=None, seed_keys=(state.customer_name or "", "company", persona)) \
                                  or get_concise_snippet(node_id="KB_QA", topic="general", persona_or_none=None, seed_keys=(state.customer_name or "", "general", persona))
                    snippet_text = (snippet_obj or {}).get("text") or "We help people build and rank simple websites that generate leads businesses pay for."
                    ack = "Totally fair."
                    inline_line = f"{ack} {snippet_text}".strip()
                    inline_line = finalize_agent_text(state, inline_line, is_objection=False)
                    await self.session.say(inline_line)
                    # Force KB node to speak immediately by bypassing gating this turn
                    state.conversation_context["force_kb_once"] = True
                    state.conversation_context["kb_inline_used"] = True
                    await self._transition_to_node("N_KB_Q&A_With_StrategicNarrative_V3_Adaptive")
                    return
            except Exception as e:
                logging.error(f"Inline company-intent handler error: {e}", exc_info=True)
            # Record analytics for user turn
