                    )
                    del state.conversation_context['pending_psp_followup']
                    
                    # Speak the follow-up response (finalized)
                    follow_up_response = finalize_agent_text(state, follow_up_response, is_objection=True)
                    await self.session.say(follow_up_response)
                    logging.info(f"Agent said PSP follow-up response: '{follow_up_response}'")
                    
                    # For PSP follow-ups, we'll use a simple transition logic
