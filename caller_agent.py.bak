                        # Continue with normal processing
                
                # Check for context-based transition second
                context_transition = None
                # Check for high engagement based on positive sentiment and detailed responses
                if (state.emotional_state == "positive" and
                    len(user_input.split()) > 10 and
                    'context_high_engagement' in current_node.get('transitions', {})):
                    context_transition = current_node['transitions']['context_high_engagement']
                # Check for low engagement based on negative sentiment and short responses
                elif (state.emotional_state == "negative" and
                      len(user_input.split()) < 5 and
                      'context_low_engagement' in current_node.get('transitions', {})):
                    context_transition = current_node['transitions']['context_low_engagement']
                
                # Check for personality-based transition
                personality_transition = None
                if state.personality_type:
                    personality_key = f"personality_{state.personality_type}"
                    if personality_key in current_node.get('transitions', {}):
                        personality_transition = current_node['transitions'][personality_key]
                
                # Use context transition, then personality transition, then default
                if context_transition and context_transition in current_node.get('transitions', {}):
                    next_node_id = current_node['transitions'][context_transition]
                elif personality_transition and personality_transition in current_node.get('transitions', {}):
                    next_node_id = current_node['transitions'][personality_transition]
                elif 'default' in current_node.get('transitions', {}):
                    next_node_id = current_node['transitions']['default']
                else:
                    # Fallback: If no default transition, use sophisticated fallback mechanism
                    next_node_id = self._fallback_transition(state, user_input)
                    if not next_node_id:
                        logging.warning(f"No default transition found for node {state.current_node_id}. Staying in current node.")
