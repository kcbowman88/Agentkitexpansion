                # PRIORITY 2: Employed responses
                # Must filter out unemployment indicators
                employed_indicators = [
                    "have a job", "i work at", "i'm a", "get a paycheck", "working for someone",
                    "i'm employed", "i work for", "i'm on salary"
                ]
                
                unemployment_indicators = [
                    "unemployed", "laid off", "lost my job", "between jobs", "not working",
                    "looking for work", "job hunting", "no job", "between positions", "looking for a new",
                    "but not for long", "not for long"
                ]
                
                # Check if user mentions employment but also indicates job searching
                has_employed_indicators = any(indicator in user_input_lower for indicator in employed_indicators)
                has_unemployment_indicators = any(indicator in user_input_lower for indicator in unemployment_indicators)
                
                # If user mentions both employment and job searching, treat as unemployed
                if has_employed_indicators and has_unemployment_indicators:
                    if "unemployed" in transitions:
                        return "unemployed"
                
                # Otherwise, check normal employment status
                is_employed = has_employed_indicators and not has_unemployment_indicators
                
